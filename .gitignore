# Entornos virtuales
venv/
.venv/

# Secretos
.env

# PDFs descargados (pesan y son recuperables: se vuelven a descargar
# de las URLs de Enagás en cualquier momento)
/data/raw/*
!/data/raw/.gitkeep

# El dataset canónico (data/gas.csv), el catálogo de métricas, las
# extracciones auditables (data/extracciones/), el manifiesto y el
# informe de monitorización SÍ se versionan en git a propósito (ver
# sección 1.1 del diseño): son pequeños y dan historial auditable.

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# IDE
.vscode/
.idea/

