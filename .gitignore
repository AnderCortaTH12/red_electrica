# Entornos virtuales
venv/
.venv/

# Secretos
.env

# Datos (se regeneran con los scripts de ingesta, no van al repo)
/data/*
!/data/.gitkeep

# Bases de datos
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Modelos entrenados (versionados aparte, no en git por peso)
/models/*
!/models/.gitkeep

# Notebooks: checkpoints de Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
