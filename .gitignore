# Entornos virtuales
venv/
.venv/

# Secretos
.env

# Datos (se regeneran con los scripts de ingesta, no van al repo)
/data/*
!/data/.gitkeep
# Excepción: catálogo de indicadores (pequeño, es documentación, caro de rehacer)
!/data/esios_indicators_catalog.json

# Bases de datos
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Modelos entrenados (versionados aparte, no en git por peso)
/models/*
!/models/.gitkeep
# Excepción: metricas del baseline (JSON pequeño, es documentación)
!/models/baseline_metrics.json

# Notebooks: checkpoints de Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
